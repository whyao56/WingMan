# ---- 运行时数据：绝对不要提交 ----
# 注意写法：忽略目录内容而不是目录本身，否则下面的 !.gitkeep 不生效
backend/data/*
!backend/data/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.vec

# ---- 聊天记录 / 音频 / 导出文件：属于隐私 ----
samples/private/
*.mht
*.eml
*.wav
*.mp3
*.m4a
*.flac

# ---- 环境与密钥 ----
.env
.env.local
*.key

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
backend/.venv-baseline/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node / 前端 ----
node_modules/
.vite/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- 本地实验 ----
scratch/
notes-local/
logs/
# 开发态下载的语音模型权重（几百 MB，绝不能进仓库）
models/

# ---- 打包产物 ----
# 注意：build/wingman.spec 是要提交的，只忽略 PyInstaller 的工作目录
build/_pyinstaller/
build/_work/
dist/
*.exe
*.pdb
.venv-build/
# 发行上传的中转目录：打过包的 zip 放这里，供上传到 GitHub Release。
# 不进仓库的理由同 dist/ —— 是二进制产物，且单个就近百 MB。
release/
