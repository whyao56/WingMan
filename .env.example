# WingMan 环境变量示例
# 复制为 .env 后按需修改；也可以完全留空 —— 留空即使用内置 Mock Provider。
# 控制台「设置」页面写入的值会覆盖这里的配置（存在 backend/data/wingman.db 的 kv 表）。

# ============ 大模型 ============
# provider: openai_compat | ollama | mock
LLM_PROVIDER=mock

# --- OpenAI 兼容云服务（DeepSeek / 通义 / Kimi / 硅基流动 / OpenAI ...）---
# 例：DeepSeek  https://api.deepseek.com/v1
# 例：硅基流动   https://api.siliconflow.cn/v1
# 例：本地中转   http://127.0.0.1:3000/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Ollama 本地模型 ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# 生成参数
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# ============ 向量模型（记忆检索用）============
# embedder: auto | cloud | hash
#   auto  -> 配了 LLM_API_KEY 就用云端 embedding，否则退化为本地哈希向量
#   hash  -> 纯本地，零依赖，精度低但足够 demo
EMBEDDER=auto
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=512

# 注：语音识别 / 通话转写相关的配置项（ASR_*、WHISPER_*、VAD_*、AUDIO_*）
# 已随该功能一并撤下，见 README「通话转写：暂停了，但思路留着」。

# ============ 服务 ============
HOST=127.0.0.1
PORT=8787
CORS_ORIGINS=*
LOG_LEVEL=info
